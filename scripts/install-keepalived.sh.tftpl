#!/bin/bash
# Installs keepalived on a master node so the API VIP can float to it.
# Rendered as a no-op when the VIP feature is disabled.

export HTTP_PROXY="${http_proxy}"
export HTTPS_PROXY="${http_proxy}"
export http_proxy="${http_proxy}"
export https_proxy="${http_proxy}"
export NO_PROXY="${join(",", no_proxy)}"
export no_proxy="${join(",", no_proxy)}"

# Ensure a sane PATH: the SSH non-login shell may not include /usr/sbin, which is
# where keepalived (and other admin binaries) live. Without this, `command -v`
# and even `apt-get`/`systemctl` lookups can fail spuriously.
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

%{ if lb_enabled ~}
# Stop Debian's first-boot apt activity so it doesn't hold the apt/dpkg lock.
sudo systemctl stop unattended-upgrades apt-daily.timer apt-daily-upgrade.timer apt-daily.service apt-daily-upgrade.service 2>/dev/null || true
sudo systemctl mask unattended-upgrades apt-daily.timer apt-daily-upgrade.timer 2>/dev/null || true
for _lockwait in $(seq 1 90); do
    if ! sudo fuser /var/lib/apt/lists/lock /var/lib/dpkg/lock-frontend /var/lib/dpkg/lock >/dev/null 2>&1; then
        break
    fi
    sleep 5
done
[ -f /etc/needrestart/needrestart.conf ] && sudo sed -i 's/#$nrconf{restart} = '"'"'i'"'"';/$nrconf{restart} = '"'"'a'"'"';/g' /etc/needrestart/needrestart.conf || true

# Retry update+install to survive transient mirror/network failures. A single
# `&&` chain can otherwise exit non-zero on a flaky mirror and leave the node
# without keepalived while the VM itself still reports created.
_apt_attempt=0
until DEBIAN_FRONTEND=noninteractive sudo -E apt-get update -y &&
      DEBIAN_FRONTEND=noninteractive sudo -E apt-get install -y keepalived; do
    _apt_attempt=$((_apt_attempt + 1))
    if [ "$_apt_attempt" -ge 5 ]; then
        echo "ERROR: failed to install keepalived after $${_apt_attempt} attempts" >&2
        exit 1
    fi
    echo "apt attempt $${_apt_attempt} failed; retrying in 10s..." >&2
    sleep 10
done

# Verify keepalived actually landed before declaring success. This is the guard
# against a silent no-op: if the binary/package is missing we fail HERE (at the
# install step) instead of later at the config-restart step with "unit not found".
if ! command -v keepalived >/dev/null 2>&1; then
    echo "ERROR: apt reported success but the keepalived binary is missing" >&2
    exit 1
fi
if ! dpkg -s keepalived >/dev/null 2>&1; then
    echo "ERROR: keepalived package is not properly installed" >&2
    exit 1
fi

sudo systemctl enable keepalived
echo "\e[1;33;4;44mKeepalived installed and verified (config pushed separately).\e[0m"
%{ else ~}
echo "VIP disabled; nothing to do."
%{ endif ~}
